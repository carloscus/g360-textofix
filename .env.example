# g360-textofix - configuracion local
#
# Copia este archivo a .env y ajusta lo que necesites.
# .env esta en .gitignore: la clave NUNCA se sube al repositorio.
#
# IMPORTANTE (Etapa 2, pendiente de facturacion):
# La cuota gratuita de Gemini API usa los textos enviados para mejorar los
# productos de Google y permite que revisores humanos los lean. Por eso la
# Etapa 2 exige la CUOTA DE PAGO activada antes de usar el corrector sobre
# correo, documentos o sistemas empresariales.
# Ver: https://ai.google.dev/gemini-api/terms  (seccion "Unpaid Services")

# --- Gemini (Etapa 2) -------------------------------------------------------
# Copia este archivo a .env y pega tu clave. El archivo .env esta en
# .gitignore: la clave NUNCA se sube al repositorio.
#
# IMPORTANTE: usa la CUOTA DE PAGO. En la cuota gratuita de Gemini API, los
# terminos dicen que Google usa los textos enviados para mejorar sus productos
# y que revisores humanos pueden leerlos. Como el corrector se usa sobre
# correo, documentos y sistemas empresariales, corresponde la cuota de pago.
# Ver: https://ai.google.dev/gemini-api/terms  (seccion "Unpaid Services")
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_S=8

# --- Corrector ---------------------------------------------------------------
# Desactiva los tonos (util en pruebas automatizadas).
TEXTOFIX_SOUND=true

# Activa/desactiva el corrector sin salir del programa.
TEXTOFIX_ENABLED=true

# Detalle de adaptadores en consola.
TEXTOFIX_VERBOSE=false

# Espera a que la aplicacion destino responda al Ctrl+C sintetico, en ms.
# Subirlo ayuda en equipos lentos; bajarlo hace la correccion mas agil.
TEXTOFIX_CLIPBOARD_TIMEOUT_MS=400